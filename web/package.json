{
  "name": "acecam-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5176 --strictPort",
    "demo:worker": "node scripts/demoWorker.mjs",
    "build": "vite build",
    "check:csp": "node scripts/checkCsp.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-acecam",
    "seed": "node scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage --project demo-acecam \"vitest run --config vitest.rules.config.js tests/rules/accessMatrix.rules.test.js && node scripts/checkRulesCoverage.mjs --out rules-coverage && vitest run --config vitest.rules.config.js --exclude tests/rules/accessMatrix.rules.test.js\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "firebase": "^13.2.0",
    "ipaddr.js": "^2.5.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}

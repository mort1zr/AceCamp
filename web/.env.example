# Configuración de Firebase para la web (PCIT-20)
#
# 1. Copia este archivo como web/.env (está en .gitignore: nunca se sube).
# 2. Completa los valores desde la consola de Firebase:
#    Configuración del proyecto → General → Tus apps → app web → firebaseConfig.
#    Pídeselos a Axel si no tienes acceso a la consola.
#
# Estos valores identifican el proyecto y viajan al navegador; no son secretos.
# La seguridad real está en firestore.rules y storage.rules.
# Aun así no se versionan, para poder cambiar de proyecto sin tocar el código.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = usar los emuladores locales (npm run emulators) con el proyecto
# "demo-acecam". No hacen falta los valores de arriba ni tocar datos reales.
VITE_USE_FIREBASE_EMULATORS=false
# Host de los emuladores (opcional). Por defecto 127.0.0.1.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

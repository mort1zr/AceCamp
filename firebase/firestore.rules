rules_version = '2';

// Reglas de Firestore por organización (PCIT-23).
// Esquema: docs/firestore-schema.md (PCIT-22). Pruebas: web/tests/rules (npm run test:rules).
//
// Principios:
// - El acceso exige sesión salvo la recepción de postulaciones por enlace activo.
//   Todo lo no listado aquí se niega.
// - Cada documento de players, matches y applications lleva orgId, y solo lo ve
//   o modifica alguien cuya ficha en users tenga ese mismo orgId.
// - orgId, createdBy y el consentimiento salen de la sesión y no se pueden cambiar.
// - El worker del modelo (PCIT-35) usa el Admin SDK, que no pasa por estas reglas:
//   por eso la web no puede escribir statistics ni los estados procesando/listo.
// - PCIT-39: admin ve su organización; coach solo sus jugadores y partidos.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudantes ----------

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // orgId del usuario que hace la petición (falla y niega si no tiene ficha).
    function myOrgId() {
      return get(userPath(request.auth.uid)).data.orgId;
    }

    function inOrg(orgId) {
      return signedIn() && orgId is string && myOrgId() == orgId
        && get(userPath(request.auth.uid)).data.role in ['admin', 'coach'];
    }

    function isAdmin() {
      return signedIn() && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function canManage(data) {
      return inOrg(data.orgId) && (isAdmin() || data.createdBy == request.auth.uid);
    }

    // ---------- Uso mensual (PCIT-41) ----------
    // Contador en orgs/{orgId}/usage/{YYYY-MM}, con el mes en UTC como request.time.

    function currentPeriod() {
      return string(request.time.year()) + '-'
        + (request.time.month() < 10 ? '0' : '') + string(request.time.month());
    }

    function usagePath(orgId) {
      return /databases/$(database)/documents/orgs/$(orgId)/usage/$(currentPeriod());
    }

    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    // La prueba de Básico dura 30 días desde planSince (DIAS_PRUEBA en planes.js, PCIT-171).
    // Vencida, la organización no tiene análisis, como "Sin plan". Sin planSince sigue vigente.
    function trialExpired(org) {
      return org.get('plan', 'free') == 'prueba'
        && org.get('planSince', null) is timestamp
        && request.time >= org.planSince + duration.value(30, 'd');
    }

    // Análisis por mes según orgs/{orgId}.plan. Mismos valores que PLANES en
    // web/src/panel/lib/planes.js: cambiar ambos a la vez (lo comprueba planes.test.js).
    // 'free' (sin plan) y cualquier valor desconocido no permiten análisis; 'ultra' no tiene tope.
    function withinPlan(orgId, analyses) {
      let org = get(/databases/$(database)/documents/orgs/$(orgId)).data;
      let plan = org.get('plan', 'free');
      return !trialExpired(org)
        && (plan == 'ultra'
          || analyses <= {'prueba': 15, 'basico': 30, 'pro': 150}.get(plan, 0));
    }

    // El partido nuevo suma exactamente uno al contador del mes, en la misma escritura.
    function countsAsAnalysis(orgId, matchId) {
      let after = getAfter(usagePath(orgId)).data;
      let before = exists(usagePath(orgId)) ? get(usagePath(orgId)).data.analyses : 0;
      return after.lastMatchId == matchId && after.analyses == before + 1;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optionalIn(data, key, allowed) {
      return data.get(key, null) == null || data.get(key, null) in allowed;
    }

    function optionalNumber(data, key) {
      return data.get(key, null) == null || data.get(key, null) is number;
    }

    function optionalText(data, key, max) {
      return data.get(key, null) == null || isText(data.get(key, null), 0, max);
    }

    // Campos que no cambian después de crear el documento.
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Invitaciones (PCIT-40) ----------

    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }

    // Invitan el dueño de la organización y sus administradores.
    function canInvite(orgId) {
      return inOrg(orgId)
        && (isAdmin()
          || get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerId == request.auth.uid);
    }

    function validConsent(consent, recordedBy) {
      return consent is map
        && consent.accepted == true
        && consent.version is string
        && consent.method in ['coach-attestation', 'self', 'guardian']
        && consent.recordedBy == recordedBy;
    }

    // ---------- users/{uid} ----------
    // Se crea en el registro (PCIT-21), en el mismo lote que su organización.

    match /users/{uid} {
      allow get: if signedIn()
        && (uid == request.auth.uid || (resource != null && inOrg(resource.data.orgId)));
      allow list: if inOrg(resource.data.orgId);

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasAll(['email', 'displayName', 'orgId', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'orgId', 'role', 'jobTitle', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && isText(request.resource.data.displayName, 2, 120)
        && request.resource.data.role == 'coach'
        && optionalText(request.resource.data, 'jobTitle', 120)
        && request.resource.data.createdAt == request.time
        // Solo puede unirse a una organización que esté creando él mismo.
        && getAfter(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.ownerId == uid;

      // O se une a una organización que lo invitó (PCIT-40): mismo orgId y rol que la
      // invitación a su correo, que en el mismo lote pasa a 'aceptada'.
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.keys().hasAll(['email', 'displayName', 'orgId', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'orgId', 'role', 'jobTitle', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && isText(request.resource.data.displayName, 2, 120)
        && optionalText(request.resource.data, 'jobTitle', 120)
        && request.resource.data.createdAt == request.time
        && get(invitePath(request.auth.token.email)).data.status == 'pendiente'
        && get(invitePath(request.auth.token.email)).data.orgId == request.resource.data.orgId
        && get(invitePath(request.auth.token.email)).data.role == request.resource.data.role
        && getAfter(invitePath(request.auth.token.email)).data.status == 'aceptada';

      // Cada uno edita su nombre y cargo. orgId y role no cambian (PCIT-39 y PCIT-40).
      allow update: if signedIn()
        && uid == request.auth.uid
        && onlyChanges(['displayName', 'jobTitle', 'updatedAt'])
        && isText(request.resource.data.displayName, 2, 120)
        && optionalText(request.resource.data, 'jobTitle', 120);

      allow delete: if false;
    }

    // ---------- orgs/{orgId} ----------

    match /orgs/{orgId} {
      allow get: if inOrg(orgId);
      allow list: if false;

      // Se crea en el registro, junto con la ficha del usuario que la crea.
      allow create: if signedIn()
        && !exists(userPath(request.auth.uid))
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'plan', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'program', 'plan', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && isText(request.resource.data.name, 2, 120)
        && optionalText(request.resource.data, 'program', 120)
        && request.resource.data.plan == 'free'
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.auth.uid)).data.orgId == orgId;

      // Solo quien la creó cambia el nombre o el programa.
      allow update: if inOrg(orgId)
        && resource.data.ownerId == request.auth.uid
        && onlyChanges(['name', 'program', 'updatedAt'])
        && isText(request.resource.data.name, 2, 120)
        && optionalText(request.resource.data, 'program', 120);

      // Checkout simulado (PCIT-158): solo el dueño contrata un plan, y solo cambia
      // plan, periodo y fecha de inicio. 'free' no se elige: es la cuenta sin plan.
      // La prueba de Básico se da una sola vez (antes de cualquier planSince).
      allow update: if inOrg(orgId)
        && resource.data.ownerId == request.auth.uid
        && onlyChanges(['plan', 'billingCycle', 'planSince'])
        && request.resource.data.plan in ['prueba', 'basico', 'pro', 'ultra']
        && (request.resource.data.plan != 'prueba' || resource.data.get('planSince', null) == null)
        && request.resource.data.billingCycle in ['mensual', 'anual']
        && request.resource.data.planSince == request.time;

      allow delete: if false;

      // Contador de análisis del mes (PCIT-41). Solo sube de uno en uno y junto con
      // el alta de un partido nuevo; borrar un partido no devuelve el análisis.
      match /usage/{period} {
        allow get, list: if inOrg(orgId);

        allow create, update: if inOrg(orgId)
          && period == currentPeriod()
          && request.resource.data.keys().hasOnly(['analyses', 'lastMatchId', 'updatedAt'])
          && request.resource.data.analyses == (resource == null ? 0 : resource.data.analyses) + 1
          // Al llegar al límite del plan no se crean más análisis en el mes.
          && withinPlan(orgId, request.resource.data.analyses)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastMatchId is string
          && !exists(matchPath(request.resource.data.lastMatchId))
          && getAfter(matchPath(request.resource.data.lastMatchId)).data.orgId == orgId;

        allow delete: if false;
      }
    }

    // ---------- invites/{email} (PCIT-40) ----------
    // El ID es el correo invitado en minúsculas. Quien invita las ve y las anula;
    // la persona invitada solo lee la suya y la acepta al registrarse.

    match /invites/{email} {
      allow get: if signedIn()
        && (email == request.auth.token.email || (resource != null && canInvite(resource.data.orgId)));
      allow list: if canInvite(resource.data.orgId);

      allow create: if canInvite(request.resource.data.orgId)
        && request.resource.data.keys().hasOnly(['email', 'orgId', 'role', 'status', 'invitedBy', 'createdAt'])
        && request.resource.data.email == email
        && email.matches('^[^@ A-Z]+@[^@ A-Z]+[.][^@ A-Z]+$')
        && email != request.auth.token.email
        && request.resource.data.role in ['coach', 'admin']
        && request.resource.data.status == 'pendiente'
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Aceptar: solo la persona invitada, en el mismo lote que crea su ficha en users.
      allow update: if signedIn()
        && email == request.auth.token.email
        && resource.data.status == 'pendiente'
        && onlyChanges(['status', 'acceptedBy', 'acceptedAt'])
        && request.resource.data.status == 'aceptada'
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && getAfter(userPath(request.auth.uid)).data.orgId == resource.data.orgId;

      // Anular una invitación que todavía no se usó.
      allow delete: if canInvite(resource.data.orgId) && resource.data.status == 'pendiente';
    }

    // ---------- players/{playerId} ----------

    function validBirthDate(value) {
      let parts = value.split('-');
      let date = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return date >= timestamp.date(1900, 1, 1) && date <= request.time;
    }

    function isMinor(value) {
      let parts = value.split('-');
      let beforeBirthday = request.time.month() < int(parts[1])
        || (request.time.month() == int(parts[1]) && request.time.day() < int(parts[2]));
      return request.time.year() - int(parts[0]) - (beforeBirthday ? 1 : 0) < 18;
    }

    function validGuardian(data) {
      let value = data.get('guardian', null);
      return value == null ? !isMinor(data.birthDate)
        : value is map && value.keys().hasAll(['name', 'phone', 'email'])
          && value.keys().hasOnly(['name', 'phone', 'email'])
          && isText(value.name, 2, 120) && isText(value.phone, 7, 32)
          && value.phone.matches('^[+0-9 ().-]{7,32}$')
          && value.phone.matches('.*[0-9].*')
          && isText(value.email, 3, 254) && value.email.matches('^[^ @]+@[^ @]+[.][^ @]+$');
    }

    function validPlayer(data) {
      return isText(data.fullName, 2, 120)
        && isIsoDate(data.birthDate)
        && validBirthDate(data.birthDate)
        && optionalText(data, 'academy', 120)
        && optionalIn(data, 'category', ['Sub-14', 'Sub-16', 'Sub-18', 'Adulto'])
        && optionalIn(data, 'dominantHand', ['diestro', 'zurdo'])
        && optionalIn(data, 'backhand', ['dos manos', 'una mano'])
        && optionalNumber(data, 'utr')
        && optionalNumber(data, 'nationalRanking')
        && optionalNumber(data, 'graduationYear')
        // Un número finito restado a sí mismo da cero; NaN/Infinity no son válidos.
        && (data.get('utr', null) == null || (data.utr >= 0 && data.utr - data.utr == 0))
        && (data.get('nationalRanking', null) == null || (data.nationalRanking is int && data.nationalRanking > 0 && data.nationalRanking <= 9007199254740991))
        && (data.get('graduationYear', null) == null || (data.graduationYear is int && data.graduationYear >= 1900 && data.graduationYear <= 2100))
        && optionalText(data, 'nationality', 60)
        && optionalText(data, 'coachName', 120)
        && validGuardian(data);
    }

    function validPlayerApplicationSource(data, playerId) {
      let application = /databases/$(database)/documents/applications/$(data.sourceApplicationId);
      return exists(application) && get(application).data.orgId == data.orgId
        && get(application).data.get('playerId', null) == null
        && getAfter(application).data.playerId == playerId;
    }

    match /players/{playerId} {
      // get de un documento inexistente se permite: no revela nada y lo usa el alta de partidos.
      allow get: if signedIn() && (resource == null || canManage(resource.data));
      allow list: if canManage(resource.data);

      allow create: if inOrg(request.resource.data.orgId)
        && request.resource.data.keys().hasAll(['orgId', 'fullName', 'birthDate', 'consent', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly([
             'orgId', 'fullName', 'birthDate', 'academy', 'category', 'dominantHand', 'backhand',
             'utr', 'nationalRanking', 'nationality', 'graduationYear', 'coachName', 'guardian',
             'consent', 'createdBy', 'createdAt', 'sourceApplicationId'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validConsent(request.resource.data.consent, request.auth.uid)
        && validPlayer(request.resource.data)
        && (!('sourceApplicationId' in request.resource.data) ||
          validPlayerApplicationSource(request.resource.data, playerId));

      allow update: if canManage(resource.data)
        && resource.data.get('deletedAt', null) == null
        && unchanged(['orgId', 'createdBy', 'createdAt', 'consent'])
        && onlyChanges([
             'fullName', 'birthDate', 'academy', 'category', 'dominantHand', 'backhand', 'utr',
             'nationalRanking', 'nationality', 'graduationYear', 'coachName', 'guardian', 'updatedAt'])
        && validPlayer(request.resource.data);

      // PCIT-42: retirar de la plantilla conserva los partidos y su identidad.
      allow update: if canManage(resource.data)
        && resource.data.get('deletedAt', null) == null
        && onlyChanges(['deletedAt', 'updatedAt'])
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if canManage(resource.data);
    }

    // ---------- matches/{matchId} ----------
    // La web crea el partido 'en cola'; el worker (Admin SDK) lo procesa.

    function validApplicationMatch(data) {
      let application = get(/databases/$(database)/documents/applications/$(data.applicationId)).data;
      return application.orgId == data.orgId && application.playerId == data.playerId
        && data.videoPath in application.videoPaths
        && data.videoPath.matches('^orgs/' + data.orgId + '/applications/' + data.applicationId + '/video[.](mp4|mov)$');
    }

    match /matches/{matchId} {
      allow get: if signedIn() && (resource == null || canManage(resource.data));
      allow list: if canManage(resource.data);

      allow create: if inOrg(request.resource.data.orgId)
        && request.resource.data.keys().hasAll([
             'orgId', 'playerId', 'playerPosition', 'opponent', 'matchDate', 'videoPath',
             'createdBy', 'createdAt', 'status'])
        && request.resource.data.keys().hasOnly([
             'orgId', 'playerId', 'playerPosition', 'opponent', 'tournament', 'matchDate', 'result',
             'surface', 'videoPath', 'inputFingerprint', 'applicationId', 'createdBy', 'createdAt', 'status',
             'startedAt', 'finishedAt', 'errorMessage', 'workerVersion', 'statistics'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'en cola'
        // Los campos del worker empiezan vacíos.
        && request.resource.data.get('statistics', null) == null
        && request.resource.data.get('startedAt', null) == null
        && request.resource.data.get('finishedAt', null) == null
        && request.resource.data.get('errorMessage', null) == null
        && request.resource.data.get('workerVersion', null) == null
        // El jugador tiene que ser de la misma organización.
        && get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.orgId
             == request.resource.data.orgId
        && get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.get('deletedAt', null) == null
        && (isAdmin() || get(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.createdBy == request.auth.uid)
        && request.resource.data.playerPosition in ['arriba', 'abajo']
        && isText(request.resource.data.opponent, 2, 120)
        && isIsoDate(request.resource.data.matchDate)
        && optionalText(request.resource.data, 'tournament', 120)
        && optionalText(request.resource.data, 'result', 120)
        && optionalIn(request.resource.data, 'surface', ['arcilla', 'dura', 'césped', 'otra'])
        && request.resource.data.videoPath is string
        && (('applicationId' in request.resource.data)
          ? request.resource.data.applicationId is string
            && request.resource.data.applicationId.matches('^[A-Za-z0-9_-]{1,128}$')
            && validApplicationMatch(request.resource.data)
          : request.resource.data.videoPath.matches(
            '^orgs/' + request.resource.data.orgId + '/matches/' + matchId + '/video[.](mp4|mov)$'))
        // Cada partido nuevo cuenta como un análisis del mes (PCIT-41).
        && countsAsAnalysis(request.resource.data.orgId, matchId);

      // La web puede corregir los datos del partido…
      allow update: if canManage(resource.data)
        && onlyChanges(['opponent', 'tournament', 'result', 'surface', 'matchDate', 'updatedAt'])
        && isText(request.resource.data.opponent, 2, 120)
        && isIsoDate(request.resource.data.matchDate)
        && optionalText(request.resource.data, 'tournament', 120)
        && optionalText(request.resource.data, 'result', 120)
        && optionalIn(request.resource.data, 'surface', ['arcilla', 'dura', 'césped', 'otra']);

      // …o reintentar un partido con error (botón Reintentar).
      allow update: if canManage(resource.data)
        && resource.data.status == 'error'
        && request.resource.data.status == 'en cola'
        && request.resource.data.get('errorMessage', null) == null
        && request.resource.data.get('statistics', null) == null
        && onlyChanges(['status', 'errorMessage', 'startedAt', 'finishedAt', 'updatedAt']);

      // No se borra un partido mientras el worker lo procesa.
      allow delete: if canManage(resource.data) && resource.data.status != 'procesando';

      match /coachNotes/{authorId} {
        function canUseOwnNote() {
          let parent = get(/databases/$(database)/documents/matches/$(matchId)).data;
          let profile = get(userPath(request.auth.uid)).data;
          return request.auth.uid == authorId
            && parent.orgId is string && profile.orgId == parent.orgId
            && parent.status == 'listo'
            && (profile.role == 'admin' || (profile.role == 'coach' && parent.createdBy == authorId));
        }

        allow get, delete: if signedIn() && canUseOwnNote();
        allow create, update: if signedIn() && canUseOwnNote()
          && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
          && isText(request.resource.data.text, 1, 2000)
          && request.resource.data.updatedAt == request.time;
      }
    }

    // ---------- applications/{applicationId} ----------
    // PCIT-54. Un enlace solo es válido si existe bajo su propia organización.
    match /orgs/{orgId}/applicationForms/{formId} {
      allow get: if resource != null || canInvite(orgId);
      allow list, delete: if canInvite(orgId);
      allow create: if canInvite(orgId)
        && formId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // PCIT-69. La configuración de Google nunca está en un documento público.
    match /orgs/{orgId}/recruitmentIntegrations/googleForms {
      allow get: if canInvite(orgId);
      allow create, update: if canInvite(orgId)
        && request.resource.data.keys().hasOnly(['formUrl', 'spreadsheetId', 'sheetId'])
        && isText(request.resource.data.formUrl, 18, 200)
        && request.resource.data.formUrl.matches('^https://(forms[.]gle/[A-Za-z0-9_-]+|docs[.]google[.]com/forms/d/(e/)?[A-Za-z0-9_-]+/viewform)$')
        && isText(request.resource.data.spreadsheetId, 1, 128)
        && request.resource.data.spreadsheetId.matches('^[A-Za-z0-9_-]+$')
        && request.resource.data.sheetId is int
        && request.resource.data.sheetId >= 0 && request.resource.data.sheetId <= 2147483647;
    }

    function publicApplicationEmail(value) {
      return isText(value, 5, 254) && value.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$');
    }

    function publicApplicationGuardian(guardian) {
      return guardian is map && guardian.keys().hasOnly(['name', 'phone', 'email'])
        && isText(guardian.name, 2, 120) && guardian.name.trim().size() >= 2
        && isText(guardian.phone, 7, 32) && guardian.phone.matches('^[+]?([ ().-]*[0-9]){7,}[ ().-]*$')
        && publicApplicationEmail(guardian.email);
    }

    function validApplicationConsent(data, recordedBy, versions) {
      let parts = data.birthDate.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let birth = timestamp.date(year, month, day);
      let today = request.time.date();
      let age = today.year() - year -
        (today.month() < month || (today.month() == month && today.day() < day) ? 1 : 0);
      let consent = data.consent;
      return year >= 1900 && birth.year() == year && birth.month() == month && birth.day() == day && birth <= today
        && validConsent(consent, recordedBy)
        && consent.keys().hasOnly(['accepted', 'version', 'method', 'recordedBy', 'recordedAt'])
        && consent.version in versions && consent.recordedAt == request.time
        && (age < 18
          ? consent.method == 'guardian' && publicApplicationGuardian(data.guardian)
          : consent.method == 'self' && data.guardian == null);
    }

    function validApplicationContactFields(data) {
      return isText(data.orgId, 1, 128) && data.orgId.matches('^[A-Za-z0-9_-]+$')
        && data.status == 'nueva' && data.createdAt == request.time
        && isText(data.fullName, 2, 120) && data.fullName.trim().size() >= 2
        && isText(data.city, 2, 100) && data.city.trim().size() >= 2
        && publicApplicationEmail(data.email)
        && data.graduationYear is int && data.graduationYear >= 1900 && data.graduationYear <= 2100
        && optionalText(data, 'academy', 120) && optionalText(data, 'message', 1000)
        && isIsoDate(data.birthDate);
    }

    function validPublicApplication(data) {
      return data.keys().hasOnly(['orgId', 'formId', 'status', 'fullName', 'birthDate', 'city',
          'email', 'graduationYear', 'academy', 'guardian', 'message', 'consent', 'createdAt'])
        && validApplicationContactFields(data)
        && data.formId is string && data.formId.matches('^[A-Za-z0-9]{20}$')
        && validApplicationConsent(data, 'public-form', ['applications-v1', 'applications-video-v1'])
        && exists(/databases/$(database)/documents/orgs/$(data.orgId)/applicationForms/$(data.formId));
    }

    function isGoogleApplicationId(applicationId) {
      return applicationId.matches('^[a-f0-9]{64}_gf$');
    }

    function validGoogleApplication(data) {
      return canInvite(data.orgId)
        && data.keys().hasOnly(['orgId', 'source', 'status', 'fullName', 'birthDate', 'city',
            'email', 'graduationYear', 'academy', 'guardian', 'message', 'consent', 'createdAt'])
        && data.source == 'google-forms'
        && validApplicationContactFields(data)
        && validApplicationConsent(data, request.auth.uid, ['applications-v1'])
        && exists(/databases/$(database)/documents/orgs/$(data.orgId)/recruitmentIntegrations/googleForms);
    }

    function validApplicationTransition(from, to) {
      return from == to
        || (from == 'nueva' && to == 'en revisión')
        || (from == 'en revisión' && to == 'analizada')
        || (from == 'analizada' && to in ['contactada', 'descartada'])
        || (from == 'contactada' && to == 'descartada');
    }

    function canLinkApplicationPlayer() {
      let next = request.resource.data;
      let player = /databases/$(database)/documents/players/$(next.playerId);
      return resource.data.get('playerId', null) == null
        && isText(next.playerId, 1, 1500) && next.playerId.matches('^[^/]+$')
        && next.updatedAt == request.time && onlyChanges(['playerId', 'updatedAt'])
        && getAfter(player).data.orgId == resource.data.orgId
        && getAfter(player).data.get('deletedAt', null) == null
        && canManage(getAfter(player).data);
    }

    match /applications/{applicationId} {
      allow get: if signedIn() && (resource == null || inOrg(resource.data.orgId));
      allow list: if inOrg(resource.data.orgId);

      allow create: if !isGoogleApplicationId(applicationId) && inOrg(request.resource.data.orgId)
        && !('formId' in request.resource.data)
        && !request.resource.data.keys().hasAny(['videoPaths', 'videoUpload', 'source'])
        && request.resource.data.get('playerId', null) == null
        && request.resource.data.status == 'nueva'
        && request.resource.data.createdAt == request.time
        && isText(request.resource.data.fullName, 2, 120)
        && isIsoDate(request.resource.data.birthDate)
        && request.resource.data.consent is map
        && request.resource.data.consent.accepted == true;

      allow create: if !isGoogleApplicationId(applicationId) && validPublicApplication(request.resource.data);
      allow create: if isGoogleApplicationId(applicationId) && validGoogleApplication(request.resource.data);

      allow update: if inOrg(resource.data.orgId)
        && unchanged(['orgId', 'formId', 'createdAt', 'consent', 'fullName', 'birthDate', 'email',
             'playerId', 'videoPaths', 'videoUpload', 'source'])
        && request.resource.data.status in ['nueva', 'en revisión', 'analizada', 'contactada', 'descartada']
        && validApplicationTransition(resource.data.status, request.resource.data.status);

      allow update: if inOrg(resource.data.orgId) && canLinkApplicationPlayer();

      allow delete: if inOrg(resource.data.orgId);
    }
  }
}

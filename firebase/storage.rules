rules_version = '2';

// Reglas de Storage para los videos de partidos (PCIT-24).
// Ruta: orgs/{orgId}/matches/{matchId}/video.mp4 | video.mov (la misma que valida la regla de matches).
// Pruebas: web/tests/storage (npm run test:rules).
//
// - Solo usuarios con sesión cuya ficha en users tenga ese orgId.
// - El video se sube antes de crear el documento del partido (flujo de PCIT-27),
//   así que no se exige que matches/{matchId} exista todavía.
// - Tamaño máximo: 500 MB (MAX_VIDEO_BYTES en web/src/panel/lib/videoUpload.js; cambiar ambos a la vez).
// - El worker (PCIT-35) lee con el Admin SDK, que no pasa por estas reglas.
// - processed.mp4 (PCIT-161) se lee con sesión de la misma organización;
//   solo el worker puede escribirlo o borrarlo mediante el Admin SDK.
service firebase.storage {
  match /b/{bucket}/o {

    function validVideo(fileName) {
      return request.resource.size > 0
        && request.resource.size <= 500 * 1024 * 1024
        && ((fileName == 'video.mp4' && request.resource.contentType == 'video/mp4')
          || (fileName == 'video.mov' && request.resource.contentType == 'video/quicktime'))
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function canAccess(orgId, matchId, beforeCreate) {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      let path = /databases/(default)/documents/matches/$(matchId);
      // PCIT-188: la administración de plataforma no concede acceso a videos.
      // Este permiso se decide con el rol y la organización de la ficha del equipo.
      return user.orgId == orgId && user.role in ['admin', 'coach']
        && (user.role == 'admin' || (firestore.exists(path)
          ? firestore.get(path).data.orgId == orgId && firestore.get(path).data.createdBy == request.auth.uid
          : beforeCreate));
    }

    match /orgs/{orgId}/matches/{matchId}/{fileName} {
      allow read: if request.auth != null && canAccess(orgId, matchId, resource.metadata.get('uploadedBy', '') == request.auth.uid);
      // Se permite reemplazar el archivo para reintentar una subida.
      allow create, update: if request.auth != null && canAccess(orgId, matchId, true) && validVideo(fileName);
      allow delete: if request.auth != null && fileName != 'processed.mp4'
        && canAccess(orgId, matchId, resource.metadata.get('uploadedBy', '') == request.auth.uid);
    }

    // Todo lo demás queda cerrado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
